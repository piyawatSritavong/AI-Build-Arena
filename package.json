{
  "name": "ai-build-arena",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "sh -c 'set -a; . apps/web/.env.local; set +a; ARENA_E2E_URL=http://localhost:3000 SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL pnpm --filter @arena/mcp test'",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,storage-api,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm --filter @arena/challenges sync && pnpm --filter @arena/loadout sync",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.119.0",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
